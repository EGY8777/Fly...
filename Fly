local plusHold = false
plusBtn.MouseButton1Down:Connect(function()
    plusHold = true
    speedLvl = math.min(MAX_LVL, speedLvl + 1)
    refreshSpd()

    task.spawn(function()
        task.wait(0.5)
        while plusHold and speedLvl < MAX_LVL do
            speedLvl = speedLvl + 1
            refreshSpd()
            task.wait(0.05)
        end
    end)
end)
plusBtn.MouseButton1Up:Connect(function() plusHold = false end)
plusBtn.MouseLeave:Connect(function() plusHold = false end)

local minusHold = false
minusBtn.MouseButton1Down:Connect(function()
    minusHold = true
    speedLvl = math.max(1, speedLvl - 1)
    refreshSpd()

    task.spawn(function()
        task.wait(0.5)
        while minusHold and speedLvl > 1 do
            speedLvl = speedLvl - 1
            refreshSpd()
            task.wait(0.05)
        end
    end)
end)
minusBtn.MouseButton1Up:Connect(function() minusHold = false end)
minusBtn.MouseLeave:Connect(function() minusHold = false end)

local function startFly()
    local char = LP.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    flying = true
    savedWalk = hum.WalkSpeed
    savedJump = hum.JumpPower
    hum.WalkSpeed = 0
    hum.JumpPower = 0

    if attachment then attachment:Destroy() end
    if lv then lv:Destroy() end
    if ao then ao:Destroy() end

    attachment = Instance.new("Attachment")
    attachment.Name = "EGY_FlyAttachment"
    attachment.Parent = hrp

    lv = Instance.new("LinearVelocity")
    lv.Attachment0 = attachment
    lv.MaxForce = 9e9
    lv.VectorVelocity = Vector3.zero
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    lv.Parent = hrp

    ao = Instance.new("AlignOrientation")
    ao.Attachment0 = attachment
    ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
    ao.MaxTorque = 9e9
    ao.Responsiveness = 200
    ao.CFrame = workspace.CurrentCamera.CFrame
    ao.Parent = hrp

    if flyConn then flyConn:Disconnect() end

    flyConn = RunService.RenderStepped:Connect(function()
        if not flying or not lv or not ao or not hrp.Parent then return end

        local cam = workspace.CurrentCamera
        local camCF = cam.CFrame
        local move = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + camCF.RightVector end

        if mobileCtrls then
            local ok, mv = pcall(function() return mobileCtrls:GetMoveVector() end)
            if ok and mv.Magnitude > 0.05 then
                move = move + camCF:VectorToWorldSpace(Vector3.new(mv.X, 0, mv.Z))
            end
        end

        if upHeld then move = move + Vector3.new(0, 1, 0) end
        if downHeld then move = move - Vector3.new(0, 1, 0) end

        if move.Magnitude > 0 then
            lv.VectorVelocity = move.Unit * (speedLvl * SPEED_MUL)
        else
            lv.VectorVelocity = Vector3.zero
        end

        ao.CFrame = camCF
    end)
end

local function stopFly()
    flying = false

    if flyConn then flyConn:Disconnect() flyConn = nil end
    if lv then lv:Destroy() lv = nil end
    if ao then ao:Destroy() ao = nil end
    if attachment then attachment:Destroy() attachment = nil end

    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = savedWalk
            hum.JumpPower = savedJump
        end
    end
end

flyBtn.MouseButton1Click:Connect(function()
    if flying then
        stopFly()
        flyBtn.BackgroundColor3 = BTN
        flyBtn.Text = "Fly"
    else
        startFly()
        flyBtn.BackgroundColor3 = BTN_ON
        flyBtn.Text = "Stop"
    end
end)

